<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/base.xml" />

  <!--
    Diagnostico temporario da falha de mTLS com o Sicoob em producao (Railway).
    Loga o wire HTTP (headers e corpo) do Apache HttpClient5 usado pelo BilletSSLConfig.
    Muito verboso — so descomentar durante uma janela de diagnostico e comentar de volta
    (redeploy) assim que os logs de EgressIpLogger/ResourceAccessException/
    LoggingX509KeyManager derem a resposta necessaria. Nao deixar ligado em producao.
  -->
  <!--
  <logger name="org.apache.hc.client5.http.wire" level="DEBUG"/>
  <logger name="org.apache.hc.client5.http.headers" level="DEBUG"/>
  -->
</configuration>
