# ==============================
# 🔹 CONFIG. DE URLS
# ==============================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# ==============================
# 🔹 AMBIENTE ATIVO
# ==============================
# local | hml | prod — escolhe qual bloco de banco abaixo é usado.
# Veja application-local.properties, application-hml.properties e application-prod.properties.
SPRING_PROFILES_ACTIVE=local

# ==============================
# 🔹 CONFIG. DE BANCO DE DADOS
# ==============================

# Usado quando SPRING_PROFILES_ACTIVE=local (MySQL local / docker-compose)
LOCAL_MYSQLHOST=localhost
LOCAL_MYSQLPORT=3306
LOCAL_MYSQLDATABASE=hortifruti_sl
LOCAL_MYSQLUSER=root
LOCAL_MYSQLPASSWORD=

# Usado quando SPRING_PROFILES_ACTIVE=hml (banco de Homologação)
HML_MYSQLHOST=
HML_MYSQLPORT=
HML_MYSQLDATABASE=
HML_MYSQLUSER=
HML_MYSQLPASSWORD=

# Usado quando SPRING_PROFILES_ACTIVE=prod (banco de Produção — em deploy real no
# Railway estas variáveis são injetadas automaticamente pela plataforma; localmente,
# preencha com os dados do proxy público do Railway só se precisar consultar dados reais)
MYSQLHOST=
MYSQLPORT=
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=

# ==============================
# 🔹 CONFIG. DE AUTENTICAÇÃO
# ==============================
JWT_SECRET=
API_SCHEDULER_TOKEN=

# ==============================
# 🔹 CONFIG. DE GOOGLE
# ==============================
CREDENTIALS_GOOGLE=
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_REDIRECT_URI=

# ==============================
# 🔹 CONFIG. DE SICOOB
# ==============================
SICOOB_CLIENT_ID=
SICOOB_API_URL=
SICOOB_AUTH_URL=
SICOOB_SCOPE=
SICOOB_NUM_CLIENTE=
SICOOB_NUM_CONTA_CORRENTE=
SICOOB_DOMAIN=

# Certificado (.pfx)
DOCUMENT_PFX=
PASSWORD_PFX=

# ==============================
# 🔹 CONFIG. DE OPENWEATHER
# ==============================
API_TOKEN=
API_URL=

# ==============================
# 🔹 CONFIG. DE FOCUS NFE
# ==============================
FOCUS_NFE_TOKEN=
FOCUS_NFE_API_URL=
FOCUS_NFE_CNPJ_EMITENTE=

COMPANY_NAME=
COMPANY_STATE_REGISTRATION=
COMPANY_CNPJ=

# ==============================
# 🔹 CONFIG. DE NOTIFICAÇÃO
# ==============================
ULTRAMSG_TOKEN=
ULTRAMSG_INSTANCE_ID=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

ACCOUNTING_EMAIL=
ACCOUNTING_WHATSAPP=

OVERDUE_NOTIFICATION_EMAILS=
