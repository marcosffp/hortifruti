# ==========================================================
# 🔹 AMBIENTE ATIVO
# ==========================================================
# local | hml | prod — define qual bloco abaixo é usado.
# Veja application-local.properties, application-hml.properties e
# application-prod.properties.
SPRING_PROFILES_ACTIVE=local

# ==========================================================
# 🔹 URLS DA APLICAÇÃO — LOCAL
# ==========================================================
LOCAL_FRONTEND_URL=http://localhost:3000
LOCAL_BACKEND_URL=http://localhost:8080

# ==========================================================
# 🔹 URLS DA APLICAÇÃO — HOMOLOGAÇÃO
# ==========================================================
HML_FRONTEND_URL=
HML_BACKEND_URL=

# ==========================================================
# 🔹 URLS DA APLICAÇÃO — PRODUÇÃO
# ==========================================================
PROD_FRONTEND_URL=
PROD_BACKEND_URL=

# ==========================================================
# 🔹 BANCO DE DADOS — LOCAL
# ==========================================================
# Usado quando SPRING_PROFILES_ACTIVE=local (MySQL local / docker-compose)
LOCAL_MYSQLHOST=localhost
LOCAL_MYSQLPORT=3306
LOCAL_MYSQLDATABASE=hortifruti_sl
LOCAL_MYSQLUSER=root
LOCAL_MYSQLPASSWORD=root

# ==========================================================
# 🔹 BANCO DE DADOS — HOMOLOGAÇÃO
# ==========================================================
# Usado quando SPRING_PROFILES_ACTIVE=hml
HML_MYSQLHOST=
HML_MYSQLPORT=
HML_MYSQLDATABASE=
HML_MYSQLUSER=
HML_MYSQLPASSWORD=

# ==========================================================
# 🔹 BANCO DE DADOS — PRODUÇÃO
# ==========================================================
# Usado quando SPRING_PROFILES_ACTIVE=prod
PROD_MYSQLHOST=
PROD_MYSQLPORT=
PROD_MYSQLDATABASE=
PROD_MYSQLUSER=
PROD_MYSQLPASSWORD=

# ==========================================================
# 🔹 AUTENTICAÇÃO
# ==========================================================
JWT_SECRET=
API_SCHEDULER_TOKEN=

# Proteção contra brute-force no login: lista separada por vírgula avisada quando um
# lockout é ativado.
SECURITY_ALERT_EMAILS=

# ==========================================================
# 🔹 GOOGLE
# ==========================================================
# GOOGLE_REDIRECT_URI não existe mais aqui: a URI de callback é derivada de
# LOCAL_BACKEND_URL/HML_BACKEND_URL/PROD_BACKEND_URL + /backup/oauth2callback (fixo).
# GMAIL / GMAIL_PASSWORD: também usados como credenciais do envio de email via Gmail SMTP
# (veja bloco NOTIFICAÇÕES abaixo). GMAIL_PASSWORD deve ser uma "App Password" gerada em
# https://myaccount.google.com/apppasswords (exige verificação em duas etapas na conta),
# não a senha normal do Gmail.
GMAIL=
GMAIL_PASSWORD=
CREDENTIALS_GOOGLE=
GOOGLE_DRIVE_CREDENTIALS=

# ==========================================================
# 🔹 SICOOB
# ==========================================================
SICOOB_CLIENT_ID=
SICOOB_API_URL=
SICOOB_AUTH_URL=
SICOOB_SCOPE=
SICOOB_NUM_CLIENTE=
SICOOB_NUM_CONTA_CORRENTE=

# ==========================================================
# 🔹 CERTIFICADO .PFX e .PEM
# ==========================================================
DOCUMENT_PFX=
PASSWORD_PFX=
DOCUMENT_PEM=

# ==========================================================
# 🔹 OPENWEATHER
# ==========================================================
API_TOKEN=
API_URL=


# ==========================================================
# 🔹 FOCUS NFE
# ==========================================================
FOCUS_NFE_CNPJ_EMITENTE=
COMPANY_NAME=
COMPANY_CNPJ=
COMPANY_STATE_REGISTRATION=

# ==========================================================
# 🔹 FOCUS NFE — HOMOLOGAÇÃO
# ==========================================================
HML_FOCUS_NFE_TOKEN=
HML_FOCUS_NFE_API_URL=

# ==========================================================
# 🔹 FOCUS NFE — PRODUÇÃ0
# ==========================================================
PROD_FOCUS_NFE_TOKEN=
PROD_FOCUS_NFE_API_URL=

# ==========================================================
# 🔹 NOTIFICAÇÕES
# ==========================================================
ULTRAMSG_TOKEN=
ULTRAMSG_INSTANCE_ID=
CHATBOT_WEBHOOK_SECRET=

# Provedor de email ativo: sendgrid | gmail | gmail-api
# Trocar aqui NÃO exige mudança de código — os provedores continuam todos implementados,
# apenas o EMAIL_PROVIDER escolhe qual é usado em runtime.
# gmail = SMTP direto (bloqueado em hosts que fecham a porta 587/465 para saída, ex: Railway)
# gmail-api = Gmail via API HTTPS, reaproveita a autorização OAuth do backup do Google Drive
#             (GOOGLE_DRIVE_CREDENTIALS, ver bloco GOOGLE acima)
EMAIL_PROVIDER=sendgrid
SENDGRID_FROM_EMAIL=
SENDGRID_API_KEY=
# Config opcional do Gmail SMTP (defaults já cobrem o Gmail padrão, só mude se necessário)
GMAIL_SMTP_HOST=
GMAIL_SMTP_PORT=
GMAIL_SMTP_CONNECTION_TIMEOUT_MS=
GMAIL_SMTP_TIMEOUT_MS=
# Nome que aparece na assinatura dos emails enviados a clientes
NOTIFICATION_SENDER_NAME=
ACCOUNTING_EMAIL=
ACCOUNTING_WHATSAPP=
OVERDUE_NOTIFICATION_EMAILS=

# ==========================================================
# 🔹 CLOUDFLARE R2 (STORAGE)
# ==========================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PROD_R2_BUCKET_NAME=
R2_ENDPOINT=
HML_R2_BUCKET_NAME=

# ==========================================================
# 🔹 BANCO DO BRASIL (BB)
# ==========================================================
BB_APP_KEY=
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_REGISTRATION_ACCESS_TOKEN=
BB_BASIC=
BB_AGENCIA=
BB_CONTA=
BB_SCOPE=
BB_CERT_PFX_PATH=
BB_AMBIENT=
