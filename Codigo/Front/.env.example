# Caminho usado pelo navegador para chamar a API. Fica same-origin (proxeado
# pelo rewrite em next.config.ts até BACKEND_URL) para que o cookie httpOnly de
# login seja first-party — sem isso, navegadores como Safari/iOS bloqueiam o
# cookie cross-site e o login nunca "gruda". Em produção precisa ser um caminho
# relativo (ex.: "/api") — o build falha (veja scripts/check-env.mjs) se não
# estiver definida ou não começar com "/".
NEXT_PUBLIC_API_URL=/api

# URL real do backend (Spring Boot), usada só no servidor Next.js para fazer o
# proxy de /api/* (nunca é exposta ao navegador). Em produção precisa começar
# com https:// — o build falha se não estiver definida ou não for https.
BACKEND_URL=http://localhost:8080
